{
    "name": "mobtaker-system/sso-client",
    "description": "MobtakerSystem Authentication SSO client (OAuth2)",
    "keywords": [
        "Mobtaker System",
        "laravel",
        "sso-client"
    ],
    "homepage": "https://github.com/mobtaker-system/sso-client",
    "license": "MIT",
    "authors": [
        {
            "name": "Hasan Mirtalebi",
            "email": "mirtalebi83@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^11.0||^12.0||^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^10.0.0||^9.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Mobtaker System\\SsoClient\\": "src/",
            "Mobtaker System\\SsoClient\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mobtaker System\\SsoClient\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mobtaker System\\SsoClient\\SsoClientServiceProvider"
            ],
            "aliases": {
                "SsoClient": "Mobtaker System\\SsoClient\\Facades\\SsoClient"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}