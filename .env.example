# MobtakerSSO Environment Configuration Example

# Enable/Disable SSO
SSO_ENABLED=true

# OAuth2 Provider Configuration
SSO_PROVIDER_NAME=mobtaker-sso
SSO_CLIENT_ID=your_client_id_here
SSO_CLIENT_SECRET=your_client_secret_here

# SSO Server Configuration
SSO_HOST=http://localhost:8000
SSO_REDIRECT_URI=http://yourapp.local/auth/sso/callback

# User Model Configuration
SSO_USER_MODEL=App\Models\User
SSO_USER_SHADOW_MODEL=MobtakerSystem\SsoClient\Models\SsoUser

# Default password for new users (if not generated)
SSO_DEFAULT_PASSWORD=temporary_password

# Session Configuration
SSO_SESSION_TOKEN_KEY=sso_access_token
SSO_SESSION_USER_KEY=sso_user
SSO_SESSION_TIMEOUT=3600

# Cache Configuration
SSO_CACHE_ENABLED=true
SSO_CACHE_TTL=3600
SSO_CACHE_PREFIX=sso_user:
